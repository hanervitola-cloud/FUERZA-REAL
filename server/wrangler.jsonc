// Earned Strength server. Deploy from this folder with:  npx wrangler deploy
// First time only (the account owner signs in when wrangler opens the browser):
//   npx wrangler login
//   npx wrangler d1 create earned-strength        -> paste the database_id below
//   npx wrangler d1 execute earned-strength --remote --file schema.sql
//   npx wrangler secret put VAPID_PUBLIC and VAPID_PRIVATE_JWK (values in .dev.vars; keep them the same forever)
//   GOOGLE_CLIENT_ID below = the web client id from Google Cloud (public, not a secret); same value in app/net.js
{
  "name": "earned-strength-api",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "routes": [{ "pattern": "api.earnedstrength.online", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "earned-strength", "database_id": "342c023f-7f17-4b39-9bcf-0e6b81a8701d" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "GOOGLE_CLIENT_ID": "373023778876-ul5nqid2apg1jhdvq1cpgf0cvneofl5e.apps.googleusercontent.com", "ORIGINS": "https://earnedstrength.online,https://www.earnedstrength.online,capacitor://localhost,https://localhost" },
  "observability": { "enabled": true }
}
