# Security rules the host (Cloudflare) adds to every page.
# Whole site: no type guessing, no framing by other sites, short referrers, only the app may use the camera.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=15552000
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# The app: it may only load code and data from the places it really uses.
# The sha256 is the small theme line at the top of app/index.html: change it together with that line.
/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-7xopFvqmkDDYJsvM/f7Mg8Ol9eYfelfYoZjDh88c934=' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://*.googleusercontent.com; media-src 'self' blob:; connect-src 'self' https://api.earnedstrength.online wss://api.earnedstrength.online https://cdn.jsdelivr.net https://storage.googleapis.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
